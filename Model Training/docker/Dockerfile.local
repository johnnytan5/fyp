FROM python:3.11-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch — compatible with Apple Silicon MPS via Rosetta or native
RUN pip install --no-cache-dir \
    torch==2.3.0 torchvision==0.18.0 \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY configs/ configs/
COPY src/ src/
COPY data/data.yaml data/data.yaml

ENV PYTHONUNBUFFERED=1

RUN mkdir -p /root/.config/Ultralytics && \
    echo 'datasets_dir: /workspace' > /root/.config/Ultralytics/settings.yaml

CMD ["python", "src/train.py", "--mode", "smoke"]
